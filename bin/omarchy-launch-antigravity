#!/usr/bin/env bash
# Unified Launcher for Google Antigravity CLI and IDE in Omarchy / Hyprland
set -euo pipefail

MODE="ide"
CONV_ID=""
WORKSPACE="${HOME}"

ARG1="${1:-}"
ARG2="${2:-}"
ARG3="${3:-}"

if [[ "$ARG1" == "cli" || "$ARG1" == "--cli" ]]; then
  MODE="cli"
  CONV_ID="$ARG2"
  WORKSPACE="${ARG3:-$HOME}"
elif [[ "$ARG1" == "resume" || "$ARG1" == "--resume" ]]; then
  MODE="cli"
  CONV_ID="$ARG2"
  WORKSPACE="${ARG3:-$HOME}"
elif [[ "$ARG1" == "status" || "$ARG1" == "--status" ]]; then
  MODE="status"
elif [[ "$ARG1" == "help" || "$ARG1" == "--help" || "$ARG1" == "-h" ]]; then
  MODE="help"
elif [[ "$ARG1" == "ide" || "$ARG1" == "--ide" ]]; then
  MODE="ide"
  WORKSPACE="${ARG2:-$HOME}"
else
  WORKSPACE="${ARG1:-$HOME}"
fi

if [[ "$MODE" == "help" ]]; then
  echo "Použití: omarchy-launch-antigravity [příkaz|cesta]"
  echo ""
  echo "Příkazy:"
  echo "  (žádný)              Spustí Antigravity IDE v domovské složce"
  echo "  <cesta>              Otevře Antigravity IDE v zadaném adresáři"
  echo "  ide [cesta]          Explicitní spuštění grafického IDE"
  echo "  cli [id] [cesta]     Spustí interaktivní CLI relaci v terminálu"
  echo "  resume [id] [cesta]  Obnoví relaci podle ID konverzace"
  echo "  status, --status     Vypíše aktuální stav modelu, kvót a telemetrie"
  echo "  help, -h             Zobrazí tuto nápovědu"
  exit 0
fi

if [[ "$MODE" == "status" ]]; then
  SCANNER_BIN=""
  if [[ -f "${HOME}/.config/omarchy/plugins/simonez.antigem/scripts/antigravity_scanner.py" ]]; then
    SCANNER_BIN="${HOME}/.config/omarchy/plugins/simonez.antigem/scripts/antigravity_scanner.py"
  elif [[ -f "$(dirname "$0")/../scripts/antigravity_scanner.py" ]]; then
    SCANNER_BIN="$(dirname "$0")/../scripts/antigravity_scanner.py"
  elif [[ -f "$(dirname "$0")/scripts/antigravity_scanner.py" ]]; then
    SCANNER_BIN="$(dirname "$0")/scripts/antigravity_scanner.py"
  fi

  if [[ -n "$SCANNER_BIN" ]]; then
    python3 - "$SCANNER_BIN" << 'EOF'
import json, sys, subprocess

try:
    scanner_path = sys.argv[1]
    res = subprocess.run(["python3", scanner_path], capture_output=True, text=True, timeout=15.0, check=True)
    d = json.loads(res.stdout)
    
    print("\033[1;36m════════════════════════════════════════════════════════════════\033[0m")
    print("\033[1;36m   Anti/Gem Telemetry Status (Google Antigravity & Gemini)      \033[0m")
    print("\033[1;36m════════════════════════════════════════════════════════════════\033[0m")
    print(f"  \033[1mModel:\033[0m            {d.get('currentModel', 'Unknown')} ({d.get('activeVersion', '').strip()})")
    print(f"  \033[1mPlán / Účet:\033[0m      {d.get('tierLabel', 'Google AI Pro')}")
    print(f"  \033[1mStav agenta:\033[0m      {d.get('activeStatus', 'Idle')}")
    
    quotas = d.get("quotas", {})
    sess = quotas.get("session", {})
    week = quotas.get("weekly", {})
    print(f"  \033[1m5h Relace kvóta:\033[0m  {sess.get('percent', 0)}% ({sess.get('detail', '')})")
    print(f"  \033[1m7d Týdenní kvóta:\033[0m {week.get('percent', 0)}% ({week.get('detail', '')})")
    
    print(f"  \033[1mContext Window:\033[0m   {d.get('contextTokensStr', '0k / 1M')} ({d.get('contextPct', 0)}%)")
    print(f"  \033[1mPrompty dnes:\033[0m     {d.get('todayPrompts', 0)} (celkem: {d.get('totalPrompts', 0)})")
    
    subagents = d.get("subagentsFleet", [])
    if subagents:
        active_cnt = sum(1 for s in subagents if s.get("status") == "Working")
        print(f"  \033[1mSubagenti:\033[0m        {len(subagents)} registrovaných ({active_cnt} aktivních)")
    print("\033[1;36m════════════════════════════════════════════════════════════════\033[0m")
except Exception as e:
    print(f"Chyba při čtení telemetrie: {e}", file=sys.stderr)
    sys.exit(1)
EOF
    exit 0
  else
    echo "Chyba: antigravity_scanner.py nebyl nalezen." >&2
    exit 1
  fi
fi

# Strip file:// URI prefix if present
if [[ "$WORKSPACE" =~ ^file://(.*) ]]; then
  WORKSPACE="${BASH_REMATCH[1]}"
fi

if [[ ! -d "$WORKSPACE" ]]; then
  WORKSPACE="$HOME"
fi

if [[ "$MODE" == "cli" ]]; then
  # Multi-account Auto Failover: check optimal account from quota selector
  CLI_CMD="agy"
  QUOTA_SELECTOR="${HOME}/.local/bin/agy-quota-selector"
  if [[ -x "$QUOTA_SELECTOR" ]]; then
    OPT_LINES=()
    mapfile -t OPT_LINES < <("$QUOTA_SELECTOR" 2>/dev/null || echo "1")
    OPT_ACC="${OPT_LINES[0]:-1}"
    OPT_STATUS="${OPT_LINES[2]:-ok}"
    if [[ "$OPT_ACC" == "3" ]]; then
      CLI_CMD="agy3"
      agy-account switch 3 --sync-only >/dev/null 2>&1 || true
      if [[ "$OPT_STATUS" == "session_depleted" || "$OPT_STATUS" == "weekly_depleted" ]]; then
        notify-send -u normal -a "Antigravity" -i "dialog-information" "Antigravity Auto-Failover" "Previous quota depleted ➔ Session started under Account 3 (agy3)." 2>/dev/null || true
      fi
    elif [[ "$OPT_ACC" == "2" ]]; then
      CLI_CMD="agy2"
      agy-account switch 2 --sync-only >/dev/null 2>&1 || true
      if [[ "$OPT_STATUS" == "session_depleted" || "$OPT_STATUS" == "weekly_depleted" ]]; then
        notify-send -u normal -a "Antigravity" -i "dialog-information" "Antigravity Auto-Failover" "Account 1 depleted ➔ Session started under Account 2 (agy2)." 2>/dev/null || true
      fi
    else
      agy-account switch 1 --sync-only >/dev/null 2>&1 || true
    fi
  fi

  SHELL_SCRIPT="cd \"\$1\" && if [[ -n \"\$2\" ]]; then $CLI_CMD --conversation \"\$2\"; else $CLI_CMD; fi; exec bash"
  if command -v xdg-terminal-exec >/dev/null 2>&1; then
    exec xdg-terminal-exec --dir="$WORKSPACE" bash -c "$SHELL_SCRIPT" _ "$WORKSPACE" "$CONV_ID"
  elif command -v foot >/dev/null 2>&1; then
    exec foot -D "$WORKSPACE" bash -c "$SHELL_SCRIPT" _ "$WORKSPACE" "$CONV_ID"
  elif command -v alacritty >/dev/null 2>&1; then
    exec alacritty --working-directory "$WORKSPACE" -e bash -c "$SHELL_SCRIPT" _ "$WORKSPACE" "$CONV_ID"
  elif command -v kitty >/dev/null 2>&1; then
    exec kitty --directory "$WORKSPACE" bash -c "$SHELL_SCRIPT" _ "$WORKSPACE" "$CONV_ID"
  fi
  exit 0
fi

# MODE == "ide"
QUOTA_SELECTOR="${HOME}/.local/bin/agy-quota-selector"
if [[ -x "$QUOTA_SELECTOR" ]]; then
  OPT_ACC=$("$QUOTA_SELECTOR" 2>/dev/null | head -n1 || echo "1")
  agy-account switch "$OPT_ACC" --sync-only >/dev/null 2>&1 || true
fi

ANTIGRAVITY_BIN="$(command -v antigravity || echo "${HOME}/.local/bin/antigravity")"
WINDOW_ADDRESS=$(hyprctl clients -j 2>/dev/null | jq -r '.[] | select((.class | test("^antigravity$"; "i")) or (.initialClass | test("^antigravity$"; "i"))) | .address' 2>/dev/null | head -n1 || true)

if [[ -n "$WINDOW_ADDRESS" && "$WINDOW_ADDRESS" != "null" ]]; then
  hyprctl dispatch focuswindow "address:$WINDOW_ADDRESS" >/dev/null 2>&1 || true
  if [[ -d "$WORKSPACE" ]]; then
    nohup "$ANTIGRAVITY_BIN" "$WORKSPACE" >/dev/null 2>&1 &
  fi
  exit 0
fi

# No window mapped: clean locks and launch
pkill -9 -x antigravity >/dev/null 2>&1 || true
pkill -9 -f "antigravity-2.0/antigravity" >/dev/null 2>&1 || true
pkill -9 -f "bin/antigravity" >/dev/null 2>&1 || true
rm -f "$HOME/.config/Antigravity/Singleton"* 2>/dev/null 2>&1 || true
sleep 0.1

nohup "$ANTIGRAVITY_BIN" "$WORKSPACE" >/dev/null 2>&1 &
